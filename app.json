{
	"expo": {
		"name": "AklanKnown",
		"slug": "aklanknown",
		"version": "1.0.1",
		"orientation": "portrait",
		"icon": "./assets/images/app-icon.png",
		"scheme": "aklanknown",
		"userInterfaceStyle": "automatic",
		"android": {
			"predictiveBackGestureEnabled": false,
			"package": "com.janleigh.aklanknown"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#fefefe",
					"android": {
						"image": "./assets/images/app-icon.png",
						"imageWidth": 200
					}
				}
			],
			"expo-font",
			"expo-web-browser",
			"expo-secure-store",
			"@rnmapbox/maps",
			"expo-image"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "6aa64f75-ec05-4386-a3e7-d99b85e0dd59"
			}
		}
	}
}
