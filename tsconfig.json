{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
	  "strict": true,
	  "module": "esnext",
	  "moduleResolution": "bundler",
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "jsx": "react-native",
	  "baseUrl": ".",
	  "paths": {
		"@/*": ["src/*"],
		"@components/*": ["src/components/*"],
		"@lib/*": ["src/lib/*"],
		"@shared/*": ["src/shared/*"]
	  }
	},
	"include": [
	  "src/**/*",
	  ".expo/types/**/*.ts",
	  "expo-env.d.ts"
	],
	"exclude": [
	  "node_modules"
	]
  }